model User {
  email String  @unique
  name  String
  image String?

  // Essentials
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // App Relationships
  apiEndpoints ApiEndpoint[]

  // Auth
  emailVerified Boolean   @default(false)
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}
